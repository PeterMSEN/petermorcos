---
import SiteHeader from "../components/SiteHeader.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Teaching experience and activities of Peter Morcos." />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>Teaching | Peter Morcos</title>
  </head>
  <body>
    <SiteHeader />
    <main>
      <div class="section-inner">
        <h1>Teaching</h1>
      </div>
    </main>
    <footer>
      <p>© {new Date().getFullYear()} Peter Morcos. All rights reserved.</p>
    </footer>
  </body>
</html>

<style>
  :root { --ink: #172d35; --muted: #687a7e; --accent: #168b83; --line: #e3e9e8; }
  * { box-sizing: border-box; }
  body { margin: 0; color: var(--ink); background: white; font-family: Arial, Helvetica, sans-serif; }
  main { min-height: calc(100vh - 137px); padding: 65px 0 90px; }
  .section-inner { width: 80%; max-width: 1250px; margin: 0 auto; }
  h1 { margin: 0; color: var(--accent); font-size: 42px; line-height: 1.3; }
  footer { padding: 22px 10%; text-align: center; border-top: 1px solid var(--line); }
  footer p { margin: 0; color: var(--muted); font-size: 13px; }
  @media (max-width: 700px) {
    main { padding-top: 48px; }
    .section-inner { width: 90%; }
    h1 { font-size: 34px; }
  }
</style>
