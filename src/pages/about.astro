
---
import SiteHeader from "../components/SiteHeader.astro";

const education = [
  {
    year: "2025",
    degree: "Ph.D.",
    field: "Materials Science and Engineering",
    institution: "Texas A&M University",
    location: "College Station, Texas, USA",
    logo: `${import.meta.env.BASE_URL}/images/logos/tamu.png`,
  },
  {
    year: "2024",
    degree: "M.S.",
    field: "Computational Mathematics",
    institution: "Texas A&M University",
    location: "College Station, Texas, USA",
    logo: `${import.meta.env.BASE_URL}/images/logos/tamu.png`,
  },
  {
    year: "2023",
    degree: "M.S.",
    field: "Materials Science and Engineering",
    institution: "Texas A&M University",
    location: "College Station, Texas, USA",
    logo: `${import.meta.env.BASE_URL}/images/logos/tamu.png`,
  },
  {
    year: "2018",
    degree: "M.Sc.",
    field: "Nanotechnology",
    institution: "The American University in Cairo",
    location: "Cairo, Egypt",
    logo: `${import.meta.env.BASE_URL}/images/logos/auc.png`,
  },
  {
    year: "2011",
    degree: "B.Sc.",
    field: "Petroleum Exploration and Production Engineering",
    institution: "Suez Canal University",
    location: "Ismailia, Egypt",
    logo: `${import.meta.env.BASE_URL}/images/logos/scu.jpg`,
  },
];

const experience = [
  {
    period: "June 2025 – Present",
    role: "Postdoctoral Research Associate",
    institution: "University of Illinois Urbana-Champaign",
    department: "Department of Mechanical Science and Engineering",
    description:
      "Conducting interdisciplinary research in metal additive manufacturing, computational modeling, process optimization, and advanced 3D printing technologies.",
    activities: [
      "Large-format metal additive manufacturing and additive friction stir deposition",
      "Embedded 3D printing and process–rheology relationships",
      "Image segmentation and melt pool characterization in LPBF",
      "Automated calibration and computational modeling",
    ],
  },
  {
    period: "August 2019 – May 2025",
    role: "Graduate Research and Teaching Assistant",
    institution: "Texas A&M University",
    department: "Materials Science and Engineering",
    description:
      "Conducted research in metal additive manufacturing, computational materials science, alloy design, and process optimization while contributing to undergraduate engineering education.",
    activities: [
      "Computationally guided alloy and process design",
      "LPBF of nickel-based and refractory alloys",
      "Physics-based modeling and data-driven process optimization",
      "Teaching experimental design, numerical methods, and engineering laboratories",
    ],
  },
  
  {
    period: "September 2011 – May 2019",
    role: "Teaching Assistant",
    institution: "The American University in Cairo",
    department: "Petroleum and Energy Engineering",
    description:
      "Supported undergraduate engineering education through laboratory instruction, practical training, and teaching activities.",
    activities: [
      "Drilling simulation and drilling engineering",
      "Reservoir engineering and rock/fluid properties",
      "Well construction and engineering laboratory instruction",
    ],
  },
  {
    period: "July 2012 – August 2019",
    role: "Drilling Engineer",
    institution: "Gulf of Suez Petroleum Company",
    department: "Petroleum Engineering",
    description:
      "Worked across drilling engineering and offshore operations, progressing through technical and operational responsibilities.",
    activities: [
      "Drilling performance engineering",
      "High-risk drilling operations",
      "Well planning and design",
      "Offshore well-site operations and drilling contracts",
    ],
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="About Peter Morcos — researcher in advanced manufacturing, computational materials science, and AI-enabled manufacturing."
    />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>About | Peter Morcos</title>
  </head>

  <body>
    <SiteHeader />

    <main>
      <!-- ABOUT ME -->
      <section class="page-intro">
        <div class="section-inner">
          <h1 class="page-title">About Me</h1>

          <div class="intro-content">
            <p>
              My academic background in Materials Science and Engineering and
              Computational Mathematics, both from Texas A&M University, has
              shaped my research approach to metal additive manufacturing.
              I am interested in developing and applying computational tools
              to understand the underlying physics of metal additive manufacturing
              processes, investigate process–material interactions, and translate
              scientific understanding into predictive capabilities for process
              optimization and materials design.
            </p>

            <p>
              My research interests span computational modeling, alloy design
              for additive manufacturing, and the integration of artificial
              intelligence into manufacturing research. More recently, I have
              become particularly interested in leveraging AI and computational
              methods to efficiently model, understand, and optimize large-scale
              manufacturing processes and components. This includes emerging
              large-format metal additive manufacturing technologies.
            </p>
          </div>
        </div>
      </section>

      <!-- RESEARCH INTERESTS AND STRATEGY -->
      <section class="research-vision">
        <div class="section-inner">
          <h2 class="page-title">Research Philosophy</h2>
          <div class="vision-content">
           
            <p>
                  How can we develop a deeper understanding of metal additive
                  manufacturing processes and use that knowledge to make them
                  more predictable, efficient, and reliable?
            </p>

            <p>
                  I approach this question by combining complementary research
                  methodologies. Numerical models provide insight into the underlying
                  physical mechanisms, while experimental investigations establish
                  physical relevance and validate predictions. Artificial intelligence
                  and machine learning, particularly when trained on computational
                  results, offer computationally efficient alternatives to expensive
                  simulations. These approaches create opportunities for real-time
                  process analysis, digital twin development, and extending predictive
                  modeling capabilities to large-scale manufacturing processes and
                  components.
            </p>

            <p>
                  Rather than treating these approaches independently, I aim to
                  integrate them into coherent frameworks that connect process
                  conditions, material behavior, and final properties. My broader
                  research vision is to advance predictive and increasingly autonomous
                  manufacturing systems through physics-informed, data-enabled
                  approaches.
            </p>
          </div>
        </div>
      </section>


        <!-- EDUCATION -->
        <section class="education-section">
        <div class="section-inner">

            <h2 class="page-title">Education</h2>

            <div class="education-timeline">
            <div class="education-line"></div>

            {education.map((item) => (
                <article class="education-item">

                <div class="education-year">
                    {item.year}
                </div>

                <div class="education-marker"></div>

                <div class="education-content">

                    <div class="education-logo">
                    <img src={item.logo} alt={`${item.institution} logo`} />
                    </div>

                    <div class="education-details">
                    <h3>
                        {item.degree} in {item.field}
                    </h3>

                    <p class="education-institution">
                        {item.institution}
                    </p>

                    <p class="education-location">
                        {item.location}
                    </p>
                    </div>

                </div>
                </article>
            ))}
            </div>

        </div>
        </section>

      <!-- PROFESSIONAL EXPERIENCE -->
      <section class="experience-section">
        <div class="section-inner">
          <p class="eyebrow">CAREER JOURNEY</p>
          <h2>Professional Experience</h2>

          <div class="experience-timeline">
            {experience.map((item) => (
              <article class="experience-item">
                <div class="experience-marker"></div>

                <div class="experience-card">
                  <span class="experience-period">{item.period}</span>

                  <h3>{item.role}</h3>
                  <h4>{item.institution}</h4>
                  <p class="experience-department">{item.department}</p>

                  <p class="experience-description">
                    {item.description}
                  </p>

                  <ul>
                    {item.activities.map((activity) => (
                      <li>{activity}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Peter Morcos. All rights reserved.</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --ink: #172d35;
    --muted: #687a7e;
    --accent: #168b83;
    --line: #e3e9e8;
    --soft: #f5f8f7;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--ink);
    background: white;
    line-height: 1.7;
  }

  /* HEADER */

  .page-title {
  font-size: 42px;
  color: #168b83;
  margin-bottom: 30px;
}

  .site-header {
    padding: 22px 10%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    border-bottom: 1px solid var(--line);
    background: white;
  }

  .site-name {
    color: var(--ink);
    font-size: 22px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 27px;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  nav a:hover,
  nav a.active {
    color: var(--accent);
  }

  /* GENERAL SECTIONS */

  .section-inner {
    width: 80%;
    max-width: 1250px;
    margin: 0 auto;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    margin: 0 0 12px;
  }

  h1,
  h2,
  h3,
  h4 {
    color: var(--ink);
    line-height: 1.3;
  }

  h1 {
    font-size: 42px;
    margin: 0 0 30px;
  }

  h2 {
    font-size: 30px;
    margin: 0 0 35px;
  }

  /* ABOUT ME */

  .page-intro {
    padding: 65px 0 70px;
  }

  .intro-content {
    max-width: 1000px;
  }

  .intro-content p {
    color: #455b61;
    text-align: justify;
    font-size: 18px;
    line-height: 1.9;
    margin: 0 0 20px;
  }

  /* RESEARCH VISION */

  .research-vision {
    padding: 65px 0 75px;
    background: var(--soft);
  }

  .vision-content {
    max-width: 1000px;
  }

  .vision-content p {
    font-size: 17px;
    line-height: 1.9;
    color: #455b61;
    margin: 0 0 22px;
  }

  /* EDUCATION */

.education-section {
  padding: 75px 0 85px;
  overflow: hidden;
}

.education-timeline {
  position: relative;
  max-width: 950px;
  margin-top: 45px;
}

.education-line {
  position: absolute;
  top: 7px;
  bottom: 38px;
  left: 112px;
  width: 2px;
  background: #b9dcd7;
}

.education-item {
  position: relative;
  display: grid;
  grid-template-columns: 76px 28px minmax(0, 1fr);
  column-gap: 22px;
  align-items: start;
  padding-bottom: 38px;
}

.education-item:last-child {
  padding-bottom: 0;
}

.education-year {
  font-size: 20px;
  font-weight: 700;
  color: var(--accent);
  text-align: right;
}

.education-marker {
  width: 14px;
  height: 14px;
  margin: 4px auto 0;
  border-radius: 50%;
  background: var(--accent);
  border: 3px solid #dcefeb;
  z-index: 1;
}

.education-content {
  display: flex;
  align-items: flex-start;
  gap: 22px;
}

.education-logo {
  width: 68px;
  height: 68px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.education-logo img {
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  object-fit: contain;
}

.education-details h3 {
  font-size: 19px;
  margin: 0 0 7px;
  color: var(--ink);
}

.education-institution {
  font-size: 16px;
  color: #52676d;
  margin: 0 0 3px;
}

.education-location {
  font-size: 14px;
  color: #849195;
  margin: 0;
}

  /* PROFESSIONAL EXPERIENCE */

  .experience-section {
    padding: 75px 0 90px;
    background: var(--soft);
  }

  .experience-timeline {
    position: relative;
    max-width: 1000px;
    margin-left: 5px;
    padding-left: 38px;
  }

  .experience-timeline::before {
    content: "";
    position: absolute;
    top: 8px;
    bottom: 15px;
    left: 8px;
    width: 2px;
    background: var(--line);
  }

  .experience-item {
    position: relative;
    padding-bottom: 42px;
  }

  .experience-item:last-child {
    padding-bottom: 0;
  }

  .experience-marker {
    position: absolute;
    top: 5px;
    left: -38px;
    width: 19px;
    height: 19px;
    background: var(--accent);
    border: 4px solid var(--soft);
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--accent);
    z-index: 1;
  }

  .experience-card {
    background: white;
    padding: 25px 30px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .experience-period {
    color: var(--accent);
    font-size: 14px;
    font-weight: 700;
  }

  .experience-card h3 {
    font-size: 21px;
    margin: 8px 0;
  }

  .experience-card h4 {
    font-size: 17px;
    margin: 0;
    font-weight: 600;
  }

  .experience-department {
    color: var(--muted);
    font-size: 14px;
    margin: 3px 0 18px;
  }

  .experience-description {
    font-size: 15px;
    line-height: 1.8;
    color: #455b61;
  }

  .experience-card ul {
    padding-left: 22px;
    margin-bottom: 0;
  }

  .experience-card li {
    font-size: 14px;
    color: #455b61;
    padding: 3px 0;
  }

  .experience-card li::marker {
    color: var(--accent);
  }

  /* FOOTER */

  .site-footer {
    padding: 22px 10%;
    text-align: center;
    border-top: 1px solid var(--line);
  }

  .site-footer p {
    color: var(--muted);
    font-size: 13px;
    margin: 0;
  }

  /* RESPONSIVE DESIGN */

  @media (max-width: 1000px) {
    .site-header {
      padding-left: 5%;
      padding-right: 5%;
    }

    nav {
      gap: 15px;
    }

    .section-inner {
      width: 90%;
    }
  }

  @media (max-width: 700px) {
    .site-header {
      flex-direction: column;
      gap: 15px;
    }

    nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px 18px;
    }

    nav a {
      font-size: 14px;
    }

    h1 {
      font-size: 34px;
    }

    h2 {
      font-size: 27px;
    }

    .page-intro,
    .research-vision,
    .education-section,
    .experience-section {
      padding-top: 48px;
      padding-bottom: 55px;
    }

    .intro-content p,
    .vision-content p {
      font-size: 16px;
      text-align: left;
    }

.education-timeline {
  margin-top: 35px;
}

.education-line {
  left: 70px;
}

.education-item {
  grid-template-columns: 48px 20px minmax(0, 1fr);
  column-gap: 12px;
  padding-bottom: 30px;
}

.education-year {
  font-size: 16px;
}

.education-content {
  gap: 12px;
}

.education-logo {
  width: 48px;
  height: 48px;
}

.education-details h3 {
  font-size: 16px;
}

.education-institution {
  font-size: 14px;
}

.education-location {
  font-size: 12px;
}
    .experience-timeline {
      padding-left: 30px;
    }

    .experience-marker {
      left: -30px;
    }

    .experience-card {
      padding: 20px;
    }
  }
</style>
