<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Research Projects | Peter Morcos</title>
  <meta
    name="description"
    content="Research projects in metal additive manufacturing, computational modeling, and AI-enabled manufacturing."
  />
</head>

<body>

  <!-- HEADER -->
  <header class="site-header">
    <div class="header-inner">
      <a href={`${import.meta.env.BASE_URL}/`} class="site-logo">Peter Morcos</a>

      <nav>
        <a href={`${import.meta.env.BASE_URL}/`}>Home</a>
        <a href={`${import.meta.env.BASE_URL}/about/`}>About</a>
        <a href={`${import.meta.env.BASE_URL}/research/`} class="active">Research</a>
        <a href={`${import.meta.env.BASE_URL}/publications/`}>Publications</a>
        <a href={`${import.meta.env.BASE_URL}/teaching/`}>Teaching</a>
        <a href={`${import.meta.env.BASE_URL}/cv/`}>CV</a>
        <a href={`${import.meta.env.BASE_URL}/contact/`}>Contact</a>
      </nav>
    </div>
  </header>

  <main>

    <!-- PAGE INTRO -->
    <section class="page-intro">
      <div class="section-inner">
        <h1 class="page-title">Research Projects</h1>
        <p class="page-description">
          Exploring the science and engineering of metal additive
          manufacturing through computational modeling, experimental
          investigations, and artificial intelligence.
        </p>
      </div>
    </section>

    <!-- PROJECT GRID -->
    <section class="projects-section">
      <div class="section-inner">

        <div class="projects-grid">
          {projects.map((project) => (
            <article class="project-card">

              <a href={project.link} class="project-image">
                <img
                  src={project.image}
                  alt={project.title}
                  class:list={{ "contain-image": project.number === "02" }}
                  loading="lazy"
                />
                <span class="project-number">{project.number}</span>
              </a>

              <div class="project-content">
                <h2>{project.title}</h2>

                <p>{project.description}</p>

                <a href={project.link} class="read-more">
                  Read More <span>→</span>
                </a>
              </div>

            </article>
          ))}
        </div>

      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="section-inner">
      <p>© 2026 Peter Morcos. All rights reserved.</p>
    </div>
  </footer>

</body>
