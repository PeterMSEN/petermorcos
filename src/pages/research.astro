
---
import SiteHeader from "../components/SiteHeader.astro";

const uiucProjects = [
  {
    number: "13",
    title: "Process–Structure–Property Relationships in CuCrZr",
    description: "Single-track experiments, local mechanical testing, and FLOW-3D simulations link laser wire deposition conditions to CuCrZr track geometry, microstructure, and mechanical response.",
    image: null,
    imageLabel: "PSP of CuCrZr via LW-DED",
    link: `${import.meta.env.BASE_URL}/research/cucrzr-uiuc/`,
  },
  {
    number: "12",
    title: "Analytical Modeling for Laser Wire DED",
    description: "An energy-balance model connects laser power, scan speed, and wire feed rate to melting and deposited track geometry.",
    image: null,
    imageLabel: "Analytical Model for LW-DED",
    link: `${import.meta.env.BASE_URL}/research/lw-ded-uiuc/`,
  },
  {
    number: "11",
    title: "Process Mapping for Embedded 3D Printing",
    description: "Printing experiments, fluid flow simulations, and Bayesian calibration aim to identify conditions that produce the desired feature geometry.",
    image: null,
    imageLabel: "Embedded 3D printing",
    link: `${import.meta.env.BASE_URL}/research/e3dp-uiuc/`,
  },
  {
    number: "10",
    title: "Automated Calibration of AdditiveFOAM",
    description: "An iterative workflow calibrates AdditiveFOAM simulations against measured melt-pool width and depth in laser powder bed fusion.",
    image: null,
    imageLabel: "AutoCalibration tool",
    link: `${import.meta.env.BASE_URL}/research/additivefoam-uiuc/`,
  },
  {
    number: "09",
    title: "AI-Driven Melt Pool Segmentation",
    description: "A general-purpose deep learning model segments melt pools in metallographic cross sections and supports automated measurement of their geometry.",
    image: `${import.meta.env.BASE_URL}/images/research/seg-uiuc/fig2.png`,
    link: `${import.meta.env.BASE_URL}/research/seg-uiuc/`,
  },
];

const tamuProjects = [
  {
    number: "08",
    title: "Computational Selection of Refractory Alloys for L-PBF",
    description: "Single-track experiments, melt-pool modeling, and multi-criteria analysis rank eight refractory alloys by printability, cracking susceptibility, mechanical performance, and cost.",
    image: `${import.meta.env.BASE_URL}/images/research/topsis-tamu/fig1.PNG`,
    link: `${import.meta.env.BASE_URL}/research/topsis-tamu/`,
  },
  {
    number: "07",
    title: "High-Throughput Alloy and Process Design",
    description: "A deep-learning surrogate accelerates probabilistic printability mapping to search alloy chemistry and process conditions together.",
    image: null,
    image: `${import.meta.env.BASE_URL}/images/research/htp-tamu/card.png`,
    link: `${import.meta.env.BASE_URL}/research/htp-tamu/`,
  },
  {
    number: "06",
    title: "Automated Printability Maps for Metal Alloys",
    description: "A computational framework uses alloy chemistry and physics-based thermal models to predict defect-free processing windows for metal alloys.",
    image: null,
    image: `${import.meta.env.BASE_URL}/images/research/auto-tamu/card.png`,
    imageLabel: "Printability maps",
    link: `${import.meta.env.BASE_URL}/research/auto-tamu/`,
  },
  {
    number: "05",
    title: "Bayesian Data-Augmented Modeling for L-PBF",
    description: "We combine analytical thermal models, machine learning, and proxy experiments to predict melt-pool dimensions across alloy chemistries.",
    image: null,
    image: `${import.meta.env.BASE_URL}/images/research/aug-tamu/card.png`,
    imageLabel: "Bayesian modeling",
    link: `${import.meta.env.BASE_URL}/research/aug-tamu/`,
  },
  {
    number: "04",
    title: "Computational Co-Design of Printable Alloys",
    description: "A perspective on combining printability screening, microstructure modeling, experiments, and data-driven optimization to co-design L-PBF alloy chemistry and process settings.",
    image: `${import.meta.env.BASE_URL}/images/research/exp-tamu/fig1.png`,
    imageLabel: "Computational alloy design",
    link: `${import.meta.env.BASE_URL}/research/exp-tamu/`,
  },
  {
    number: "03",
    title: "Powder Feedstock and Process Effects on L-PBF IN718",
    description:
      "We used design of experiments and statistical analysis to study how powder characteristics and energy input affect IN718 density and mechanical properties.",
    image: `${import.meta.env.BASE_URL}/images/research/lpbf2-tamu/card.png`,
    imageLabel: "Powder feedstock and process effects",
    link: `${import.meta.env.BASE_URL}/research/lpbf2-tamu/`,
  },
  {
    number: "02",
    title: "Influence of Layer Thickness on AM IN718 by L-PBF",
    description:
      "We developed and validated a printability framework to compare nickel alloy 718 builds made with 60 μm and 90 μm powder layers.",
    image: `${import.meta.env.BASE_URL}/images/research/lpbf1-tamu/card.png`,
    imageLabel: "Layer thickness and printability",
    link: `${import.meta.env.BASE_URL}/research/lpbf1-tamu/`,
  },
];

const aucProjects = [
  {
    number: "01",
    title: "Nanostructured Mg–Zn–Zr Alloys",
    description:
      "We used mechanical alloying and hot pipe rolling to produce nanostructured magnesium alloy sheets for potential biomedical applications.",
    image: `${import.meta.env.BASE_URL}/images/research/mg-auc/card.png`,
    imageLabel: "Nanostructured magnesium alloys",
    link: `${import.meta.env.BASE_URL}/research/mg-auc/`,
  },
];

const projectGroups = [
  { id: "uiuc-research", title: "Postdoctoral Research – University of Illinois Urbana-Champaign", projects: uiucProjects },
  { id: "tamu-research", title: "PhD Research (Materials Science and Engineering) – Texas A&M University", projects: tamuProjects },
  { id: "auc-research", title: "Master’s Research (Nanotechnology) – American University in Cairo", projects: aucProjects },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Research Projects | Peter Morcos</title>
  <meta
    name="description"
    content="Research projects in metal additive manufacturing, computational modeling, and AI-enabled manufacturing."
  />
  <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
</head>

<body>

  <SiteHeader />

  <main>

    <!-- PAGE INTRO -->
    <section class="page-intro">
      <div class="section-inner">
        <h1 class="page-title">Research Projects</h1>
        <p class="page-description">
          Exploring the science and engineering of metal additive
          manufacturing through computational modeling, experimental
          investigations, and artificial intelligence.
        </p>
      </div>
    </section>

    <!-- PROJECT GRID -->
    <section class="projects-section">
      <div class="section-inner">

        {projectGroups.map((group) => (
          <section class="project-group" aria-labelledby={group.id}>
            <h2 id={group.id} class="project-group-title">{group.title}</h2>
            <div class="projects-grid">
              {group.projects.map((project) => (
                <article class="project-card">
                  <a href={project.link} class="project-image" aria-label={project.image ? undefined : project.title}>
                    {project.image ? (
                      <img
                        src={project.image}
                        alt={project.title}
                        class:list={{ "contain-image": ["02", "07", "08", "09"].includes(project.number) }}
                        loading="lazy"
                      />
                    ) : (
                      <span class="project-image-placeholder" aria-hidden="true">
                        <span>Research project</span>
                        <strong>{project.imageLabel}</strong>
                      </span>
                    )}
                    <span class="project-number">{project.number}</span>
                  </a>

                  <div class="project-content">
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                    <a href={project.link} class="read-more">
                      Read More <span>→</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}

      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="section-inner">
      <p>© 2026 Peter Morcos. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>

<style>
  :root {
    --ink: #172d35;
    --accent: #168b83;
    --muted: #687a7e;
    --light: #f5f8f7;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Arial, sans-serif;
    color: var(--ink);
    background: #ffffff;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* HEADER */
  .site-header {
    background: #ffffff;
    border-bottom: 1px solid #e8eeec;
    padding: 0 8%;
  }

  .header-inner {
    max-width: 1200px;
    min-height: 78px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .site-logo {
    font-size: 21px;
    font-weight: 700;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 25px;
  }

  nav a {
    font-size: 14px;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  nav a:hover,
  nav a.active {
    color: var(--accent);
  }

  /* PAGE INTRO */
  .page-intro {
    padding: 65px 8% 35px;
  }

  .section-inner {
    max-width: 1200px;
    margin: auto;
  }

  .page-title {
    font-size: 42px;
    color: var(--accent);
    margin: 0 0 18px;
  }

  .page-description {
    max-width: 780px;
    font-size: 17px;
    line-height: 1.8;
    color: var(--muted);
    margin: 0;
  }

  /* PROJECT GRID */
  .projects-section {
    padding: 35px 8% 90px;
  }

  .project-group + .project-group {
    margin-top: 48px;
  }

  .project-group-title {
    font-size: 28px;
    margin: 0 0 24px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .project-card {
    background: #ffffff;
    border: 1px solid #e8eeec;
    border-radius: 8px;
    overflow: hidden;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(23, 45, 53, 0.10);
  }

  .project-image {
    display: block;
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--light);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-image-placeholder {
    width: 100%;
    height: 100%;
    padding: 35px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 9px;
    color: var(--ink);
    text-align: center;
    background:
      linear-gradient(135deg, rgba(22, 139, 131, 0.12), rgba(22, 139, 131, 0.02)),
      var(--light);
  }

  .project-image-placeholder > span {
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .project-image-placeholder strong {
    max-width: 240px;
    font-size: 21px;
    line-height: 1.35;
  }

  .project-image img.contain-image {
    object-fit: contain;
    padding: 0px;
  }

  .project-card:hover .project-image img {
    transform: scale(1.05);
  }

  .project-card:hover .project-image img.contain-image {
    transform: none;
  }

  .project-number {
    position: absolute;
    left: 15px;
    top: 15px;
    background: rgba(255, 255, 255, 0.95);
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
    padding: 7px 11px;
    border-radius: 4px;
  }

  .project-content {
    padding: 24px;
  }

  .project-content h3 {
    font-size: 20px;
    line-height: 1.4;
    margin: 0 0 13px;
    color: var(--ink);
  }

  .project-content p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0 0 22px;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
    color: var(--accent);
  }

  .read-more span {
    transition: transform 0.2s ease;
  }

  .read-more:hover span {
    transform: translateX(5px);
  }

  /* FOOTER */
  .site-footer {
    background: var(--light);
    padding: 25px 8%;
    color: var(--muted);
    font-size: 13px;
  }

  /* RESPONSIVE */
  @media (max-width: 950px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .header-inner {
      flex-wrap: wrap;
      padding: 18px 0;
    }

    nav {
      flex-wrap: wrap;
      gap: 15px;
    }
  }

  @media (max-width: 600px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .page-title {
      font-size: 34px;
    }

    .page-intro {
      padding-top: 45px;
    }

    .projects-section {
      padding-bottom: 55px;
    }
  }
</style>
