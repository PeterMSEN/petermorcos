<style>
  :root {
    --ink: #172d35;
    --accent: #168b83;
    --muted: #687a7e;
    --light: #f5f8f7;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Arial, sans-serif;
    color: var(--ink);
    background: #ffffff;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* HEADER */
  .site-header {
    background: #ffffff;
    border-bottom: 1px solid #e8eeec;
    padding: 0 8%;
  }

  .header-inner {
    max-width: 1200px;
    min-height: 78px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .site-logo {
    font-size: 21px;
    font-weight: 700;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 25px;
  }

  nav a {
    font-size: 14px;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  nav a:hover,
  nav a.active {
    color: var(--accent);
  }

  /* PAGE INTRO */
  .page-intro {
    padding: 65px 8% 35px;
  }

  .section-inner {
    max-width: 1200px;
    margin: auto;
  }

  .page-title {
    font-size: 42px;
    color: var(--accent);
    margin: 0 0 18px;
  }

  .page-description {
    max-width: 780px;
    font-size: 17px;
    line-height: 1.8;
    color: var(--muted);
    margin: 0;
  }

  /* PROJECT GRID */
  .projects-section {
    padding: 35px 8% 90px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .project-card {
    background: #ffffff;
    border: 1px solid #e8eeec;
    border-radius: 8px;
    overflow: hidden;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(23, 45, 53, 0.10);
  }

  .project-image {
    display: block;
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--light);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-image img.contain-image {
    object-fit: contain;
    padding: 0px;
  }

  .project-card:hover .project-image img {
    transform: scale(1.05);
  }

  .project-card:hover .project-image img.contain-image {
    transform: none;
  }

  .project-number {
    position: absolute;
    left: 15px;
    top: 15px;
    background: rgba(255, 255, 255, 0.95);
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
    padding: 7px 11px;
    border-radius: 4px;
  }

  .project-content {
    padding: 24px;
  }

  .project-content h2 {
    font-size: 20px;
    line-height: 1.4;
    margin: 0 0 13px;
    color: var(--ink);
  }

  .project-content p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0 0 22px;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
    color: var(--accent);
  }

  .read-more span {
    transition: transform 0.2s ease;
  }

  .read-more:hover span {
    transform: translateX(5px);
  }

  /* FOOTER */
  .site-footer {
    background: var(--light);
    padding: 25px 8%;
    color: var(--muted);
    font-size: 13px;
  }

  /* RESPONSIVE */
  @media (max-width: 950px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .header-inner {
      flex-wrap: wrap;
      padding: 18px 0;
    }

    nav {
      flex-wrap: wrap;
      gap: 15px;
    }
  }

  @media (max-width: 600px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .page-title {
      font-size: 34px;
    }

    .page-intro {
      padding-top: 45px;
    }

    .projects-section {
      padding-bottom: 55px;
    }
  }
</style>
