---
const title =
  "Influence of Layer Thickness on the Printability of Nickel Alloy 718: A Systematic Process Optimization Framework";

const authors =
  "D. Shoukr, P. Morcos, T. Sundermann, T. Dobrowolski, C. Yates, J. R. Jain, R. Arróyave, I. Karaman, and A. Elwany";
const publication = "Additive Manufacturing, Volume 73 (2023), Article 103646";
const doi = "https://doi.org/10.1016/j.addma.2023.103646";

const objectives = [
  {
    number: "01",
    title: "Study printability across the process space",
    description:
      "Evaluate laser power and scan speed combinations while accounting for lack of fusion, keyholing, and balling.",
  },
  {
    number: "02",
    title: "Assess two powder-layer thicknesses",
    description:
      "Compare 60 μm and 90 μm layers to understand their effects on the printable region and production rate.",
  },
  {
    number: "03",
    title: "Validate predicted process windows",
    description:
      "Test selected parameter combinations using density, porosity, and tensile measurements.",
  },
];

const processSteps = [
  {
    number: "01",
    title: "Build an initial process map",
    description:
      "Use the Eagar–Tsai analytical thermal model to survey laser power and scan speed for each layer thickness.",
  },
  {
    number: "02",
    title: "Calibrate melt-pool predictions",
    description:
      "Print and characterize single tracks across the process space, then combine the measurements with the model using statistical calibration.",
  },
  {
    number: "03",
    title: "Identify defect regions and hatch spacing",
    description:
      "Use melt-pool geometry to classify lack of fusion, keyholing, and balling, and estimate a conservative maximum hatch spacing for adequate fusion.",
  },
  {
    number: "04",
    title: "Validate density and performance",
    description:
      "Print density coupons and tensile specimens from selected regions, then evaluate porosity and mechanical properties.",
  },
];

const findings = [
  {
    value: "99.99%",
    label: "Optical density",
    description: "Achieved for selected process conditions at both layer thicknesses.",
  },
  {
    value: "7.102 mm³/s",
    label: "Maximum VBR · 60 μm",
    description: "Volumetric build rate under the study's conservative hatch-spacing criterion.",
  },
  {
    value: "6.922 mm³/s",
    label: "Maximum VBR · 90 μm",
    description: "The larger layer did not increase maximum VBR with the criterion used.",
  },
  {
    value: "1047 / 1021 MPa",
    label: "Mean UTS · 60 / 90 μm",
    description: "The 60 μm group had a higher average ultimate tensile strength.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="A systematic printability and process optimization study of laser powder bed fusion of nickel alloy 718 at 60 μm and 90 μm layer thicknesses."
    />
    <title>{title} | Peter Morcos</title>
  </head>

  <body>
    <header class="site-header">
      <a href={`${import.meta.env.BASE_URL}/`} class="site-name">Peter Morcos, PhD</a>

      <nav aria-label="Main navigation">
        <a href={`${import.meta.env.BASE_URL}/`}>Home</a>
        <a href={`${import.meta.env.BASE_URL}/about/`}>About</a>
        <a href={`${import.meta.env.BASE_URL}/research/`} class="active">Research</a>
        <a href={`${import.meta.env.BASE_URL}/publications/`}>Publications</a>
        <a href={`${import.meta.env.BASE_URL}/teaching/`}>Teaching</a>
        <a href={`${import.meta.env.BASE_URL}/cv/`}>CV</a>
        <a href={`${import.meta.env.BASE_URL}/contact/`}>Contact</a>
      </nav>
    </header>

    <main>
      <section class="project-intro">
        <div class="section-inner">
          <a href={`${import.meta.env.BASE_URL}/research/`} class="back-link">← Back to Research</a>
          <h1>{title}</h1>
          <p class="project-authors">{authors}</p>
          <p class="project-publication">{publication}</p>
          <div class="project-meta">
            <span class="project-status">Published Research</span>
            <a href={doi} target="_blank" rel="noopener noreferrer">View Publication ↗</a>
          </div>
        </div>
      </section>

      <section class="overview-section">
        <div class="section-inner">
          <h2>Research Overview</h2>
          <div class="overview-content">
            <p>
              Selecting laser powder bed fusion (L-PBF) parameters for nickel alloy 718 is challenging because
              laser power, scan speed, hatch spacing, and powder-layer thickness interact to shape melt pools,
              porosity, microstructure, and mechanical performance. Common aggregate measures such as linear
              or volumetric energy density can hide the effects of individual parameters.
            </p>
            <p>
              This study applies a systematic printability framework to compare 60 μm and 90 μm powder layers.
              The framework searches laser power and scan speed combinations, predicts defect-prone regions,
              and estimates a conservative maximum hatch spacing. Density and tensile testing then validate
              selected conditions from the predicted process windows.
            </p>
          </div>
        </div>
      </section>

      <section class="objectives-section">
        <div class="section-inner">
          <h2>Research Objectives</h2>
          <div class="objectives-grid">
            {objectives.map((item) => (
              <article class="objective-card">
                <span class="card-number">{item.number}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="methodology-section">
        <div class="section-inner">
          <h2>Experimental and Computational Methodology</h2>
          <p class="section-lead">
            Analytical melt-pool modeling and single-track experiments were combined to map candidate
            process windows, followed by density, porosity, and tensile testing of selected builds.
          </p>
          <div class="process-list">
            {processSteps.map((step) => (
              <article class="process-item">
                <span class="process-number">{step.number}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="results-section">
        <div class="section-inner">
          <h2 class="results-heading">Results and Discussion</h2>
          <p class="results-subtitle">Layer thickness changes the size of the process window</p>
          <div class="results-content">
            <p>
              The 90 μm layer thickness required greater energy input to form sufficiently deep melt pools,
              which reduced its predicted good-printability region. The framework identified parameter
              combinations that produced parts with optical-microscopy density up to 99.99% for both layer
              thicknesses.
            </p>
            <p>
              Under the conservative maximum hatch-spacing criterion, the highest measured volumetric build
              rates were 7.102 mm³/s for 60 μm and 6.922 mm³/s for 90 μm. The larger layer thickness therefore
              did not raise the maximum build rate in this study, although using 90 μm can reduce the number of
              layers needed for a given part height.
            </p>
            <p>
              Tensile tests showed higher average ultimate tensile and yield strengths for the 60 μm group.
              Average ultimate tensile strength was 1047.3 MPa for 60 μm and 1021.1 MPa for 90 μm, while the
              average yield strengths were 754.1 MPa and 647.1 MPa, respectively. The study found no
              statistically significant difference in average elongation at fracture or toughness. Some 90 μm
              specimens showed premature fracture associated with lack-of-fusion porosity, even though their
              selected parameters fell within the predicted good-printability region.
            </p>
          </div>

          <div class="results-figures">
            <figure class="research-figure">
              <img
                class="figure-image"
                src={`${import.meta.env.BASE_URL}/images/research/lpbf1-tamu/fig2.png`}
                alt="Optical microscopy relative density for selected cubes at 60 μm and 90 μm layer thicknesses"
                loading="lazy"
              />
              <figcaption>
                Relative density using optical microscopy imaging of the selected cubes for (a) 60 μm and (b) 90 μm layer thicknesses.
              </figcaption>
            </figure>

            <figure class="research-figure">
              <img
                class="figure-image"
                src={`${import.meta.env.BASE_URL}/images/research/lpbf1-tamu/fig1.png`}
                alt="Printability maps for 60 μm and 90 μm layers with volumetric build-rate contours"
                loading="lazy"
              />
              <figcaption>
                Printability maps for 60 μm and 90 μm layer thicknesses with the volumetric build-rate contours superimposed.
              </figcaption>
            </figure>
          </div>

          <div class="metrics-grid">
            {findings.map((item) => (
              <article class="metric-card">
                <span class="metric-value">{item.value}</span>
                <h3>{item.label}</h3>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="conclusions-section">
        <div class="section-inner">
          <h2>Conclusions and Outlook</h2>
          <div class="conclusions-content">
            <p>
              The study demonstrates a way to search a broad L-PBF parameter space while accounting for
              individual process parameters and major porosity mechanisms. Its maps supported the selection
              of high-density nickel alloy 718 builds at both 60 μm and 90 μm layer thicknesses.
            </p>
            <p>
              Increasing layer thickness reduced the good-printability region and did not increase the maximum
              volumetric build rate under the conservative hatch-spacing rule. The results point to hatch-spacing
              optimization as a route to improving productivity, while the premature failures observed in some
              90 μm specimens show that the predicted process window can benefit from further validation.
            </p>
          </div>
        </div>
      </section>

      <section class="publication-section">
        <div class="section-inner">
          <h2>Related Publication</h2>
          <div class="publication-card">
            <p class="publication-label">RESEARCH ARTICLE · 2023</p>
            <h3>{title}</h3>
            <p>{authors}</p>
            <p class="publication-name">{publication}</p>
            <a href={doi} target="_blank" rel="noopener noreferrer">Read publication ↗</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Peter Morcos. All rights reserved.</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --ink: #172d35;
    --muted: #687a7e;
    --accent: #168b83;
    --line: #e3e9e8;
    --soft: #f5f8f7;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--ink);
    background: white;
    line-height: 1.7;
  }

  .site-header {
    padding: 22px 10%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    border-bottom: 1px solid var(--line);
    background: white;
  }

  .site-name {
    color: var(--ink);
    font-size: 22px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  nav { display: flex; align-items: center; gap: 27px; }
  nav a { color: var(--muted); text-decoration: none; font-size: 15px; font-weight: 600; }
  nav a:hover, nav a.active { color: var(--accent); }

  .section-inner { width: 80%; max-width: 1250px; margin: 0 auto; }

  h1, h2, h3, h4 { color: var(--ink); line-height: 1.3; }
  h2 { font-size: 30px; margin: 0 0 30px; }

  .project-intro { padding: 55px 0 65px; }
  .back-link { display: inline-block; color: var(--accent); text-decoration: none; font-weight: 700; margin-bottom: 28px; }
  .back-link:hover { text-decoration: underline; }
  .project-intro h1 { max-width: 1050px; font-size: 42px; line-height: 1.25; margin: 0 0 22px; }
  .project-authors { color: #455b61; font-size: 16px; margin: 0 0 4px; }
  .project-publication { color: var(--muted); font-size: 15px; margin: 0; }
  .project-meta { display: flex; align-items: center; gap: 25px; margin-top: 25px; }
  .project-status { display: inline-block; color: var(--accent); background: #eaf5f3; padding: 5px 13px; border-radius: 4px; font-size: 13px; font-weight: 700; }
  .project-meta a, .publication-card a { color: var(--accent); text-decoration: none; font-size: 14px; font-weight: 700; }
  .project-meta a:hover, .publication-card a:hover { text-decoration: underline; }

  .overview-section, .methodology-section, .publication-section { padding: 70px 0 80px; }
  .overview-content, .results-content, .conclusions-content { max-width: 1000px; }
  .overview-content p, .results-content p, .conclusions-content p {
    color: #455b61;
    font-size: 17px;
    line-height: 1.9;
    margin: 0 0 20px;
    text-align: justify;
  }

  .objectives-section, .results-section, .conclusions-section { padding: 70px 0 80px; background: var(--soft); }
  .objectives-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .objective-card { background: white; border: 1px solid var(--line); border-radius: 8px; padding: 27px; }
  .card-number { color: var(--accent); font-size: 14px; font-weight: 700; }
  .objective-card h3 { font-size: 19px; margin: 15px 0 10px; }
  .objective-card p { color: #52676d; font-size: 15px; line-height: 1.8; margin: 0; text-align: justify; }

  .section-lead { max-width: 900px; color: #52676d; font-size: 17px; line-height: 1.8; margin: -10px 0 35px; text-align: justify; }
  .process-list { max-width: 1000px; }
  .process-item { display: grid; grid-template-columns: 55px 1fr; gap: 22px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .process-item:last-child { border-bottom: none; }
  .process-number { color: var(--accent); font-size: 19px; font-weight: 700; }
  .process-item h3 { font-size: 19px; margin: 0 0 7px; }
  .process-item p { color: #52676d; font-size: 15px; line-height: 1.8; margin: 0; text-align: justify; }

  .results-heading { color: var(--ink); font-size: 34px; margin-bottom: 8px; }
  .results-subtitle { color: var(--accent); font-size: 22px; font-weight: 600; margin: 0 0 28px; }
  .results-figures { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px; margin-top: 38px; }
  .research-figure { margin: 0; min-width: 0; }
  .figure-image { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 6px; background: white; }
  .research-figure figcaption { color: var(--muted); font-size: 15px; line-height: 1.6; margin-top: 12px; text-align: center; }
  .metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 35px; }
  .metric-card { padding: 23px 18px; background: white; border: 1px solid var(--line); border-radius: 7px; }
  .metric-value { display: block; color: var(--accent); font-size: 25px; font-weight: 700; line-height: 1.3; }
  .metric-card h3 { font-size: 15px; margin: 10px 0 6px; }
  .metric-card p { color: var(--muted); font-size: 13px; line-height: 1.6; margin: 0; }

  .publication-card { max-width: 900px; padding: 28px 32px; border: 1px solid var(--line); border-radius: 8px; background: var(--soft); }
  .publication-label { color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: 1px; margin: 0 0 10px; }
  .publication-card h3 { font-size: 19px; margin: 0 0 12px; }
  .publication-card p { color: #52676d; font-size: 14px; margin: 5px 0; }
  .publication-card .publication-name { color: var(--muted); margin-bottom: 18px; }

  .site-footer { padding: 22px 10%; text-align: center; border-top: 1px solid var(--line); }
  .site-footer p { color: var(--muted); font-size: 13px; margin: 0; }

  @media (max-width: 1000px) {
    .site-header { padding-left: 5%; padding-right: 5%; }
    nav { gap: 15px; }
    .section-inner { width: 90%; }
    .metrics-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 700px) {
    .site-header { flex-direction: column; gap: 15px; }
    nav { flex-wrap: wrap; justify-content: center; gap: 12px 18px; }
    nav a { font-size: 14px; }
    .project-intro h1 { font-size: 32px; }
    h2 { font-size: 27px; }
    .project-intro, .overview-section, .objectives-section, .methodology-section,
    .results-section, .conclusions-section, .publication-section { padding-top: 48px; padding-bottom: 55px; }
    .overview-content p, .results-content p, .conclusions-content p, .section-lead { font-size: 16px; }
    .objectives-grid { grid-template-columns: 1fr; }
    .results-figures { grid-template-columns: 1fr; }
    .results-heading { font-size: 30px; }
    .results-subtitle { font-size: 19px; }
    .metrics-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .metric-card { padding: 18px 14px; }
    .metric-value { font-size: 21px; }
    .project-meta { flex-wrap: wrap; gap: 15px; }
  }
</style>
