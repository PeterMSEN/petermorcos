  title: "Computationally Guided Selection of Refractory Multi-Principal Element Alloys for Laser Powder Bed Fusion",
  description: "An experimental and computational framework for ranking eight refractory alloys for laser powder bed fusion.",
  overviewTitle: "Research Summary",
  overview: [
    "Refractory multi-principal element alloys (RMPEAs) are promising candidates for high-temperature structures, but their use in laser powder bed fusion (L-PBF) is limited by printability challenges and susceptibility to solidification cracking. This study combines single-track experiments, physics-based modeling, machine learning, and multi-criteria decision analysis to compare eight refractory alloy compositions.",
  ],
  objectives: [
    { number: "01", title: "Assess printability and cracking", description: "Use single-track measurements and thermal modeling to identify candidate process windows and assess cracking susceptibility." },
    { number: "02", title: "Rank candidate compositions", description: "Identify alloys that balance printability, crack resistance, mechanical performance, and material cost." },
  ],
  approachTitle: "Methodology",
  methodLead: "The workflow proceeds from initial process mapping and experimental characterization to a weighted ranking of candidate compositions.",
  methodSteps: [
    { number: "01", title: "Map and test initial process conditions", description: "Use a low-fidelity analytical melt-pool model to generate preliminary process maps, guide single-track L-PBF experiments, and select conditions for measuring melt-pool dimensions." },
    { number: "02", title: "Correct melt-pool predictions with experimental data", description: "Use hierarchical Gaussian process regression (GPR) to update analytical predictions with measured melt-pool dimensions and generate experimentally informed printability maps for each alloy." },
    { number: "03", title: "Assess thermal gradients and cracking", description: "Use an Eagar–Tsai-based thermal model (EASM) to estimate longitudinal and transverse thermal gradients and assess the associated thermal stresses. Combine the thermal analysis with material indicators of solidification and cracking susceptibility." },
