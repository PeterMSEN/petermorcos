---
import SiteHeader from "../../components/SiteHeader.astro";

const title =
  "Mechanically Alloyed Magnesium-Based Nanostructured Alloy Powders for Biomedical Applications";
const authors = "P. Morcos, K. I. ElKhodary, and H. G. Salem";
const publication = "Magnesium Technology 2017";
const doi = "https://doi.org/10.1007/978-3-319-52392-7_9";

const methods = [
  {
    number: "01",
    title: "Mechanical alloying",
    description:
      "Elemental Mg, Zn, and Zr powders were blended to Mg-5Zn-0.5Zr (wt.%) under argon and milled for 45 h in a high-energy planetary mill using a 15:1 ball-to-powder ratio and ethanol as a process-control agent.",
  },
  {
    number: "02",
    title: "Powder characterization",
    description:
      "SEM tracked particle morphology and size, while XRD quantified phase evolution, crystallite refinement, and lattice strain as milling progressed.",
  },
  {
    number: "03",
    title: "Consolidation and testing",
    description:
      "The milled powder was sealed in copper tubes, hot rolled at 300 °C with intermediate reheating, and evaluated using XRD, microscopy, and nanoindentation.",
  },
];

const findings = [
  { value: "45 h", label: "Complete alloying", description: "Elemental peaks largely disappeared after prolonged milling." },
  { value: "600 nm", label: "Particle size", description: "Average particle size after 45 h of milling." },
  { value: "8.83 nm", label: "Crystallite size", description: "Nanocrystalline powder produced by mechanical alloying." },
  { value: "3.0 GPa", label: "Peak hardness", description: "Measured for the shorter annealing condition." },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Mechanical alloying and consolidation of nanostructured Mg-Zn-Zr powders for potential biomedical applications." />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>{title} | Peter Morcos</title>
  </head>
  <body>
    <SiteHeader />
    <main>
      <section class="project-intro">
        <div class="section-inner">
          <a href={`${import.meta.env.BASE_URL}/research/`} class="back-link">← Back to Research</a>
          <h1>{title}</h1>
          <p class="project-authors">{authors}</p>
          <p class="project-publication">{publication}</p>
          <div class="project-meta">
            <span class="project-status">Published Research</span>
            <a href={doi} target="_blank" rel="noopener noreferrer">View Publication ↗</a>
          </div>
        </div>
      </section>

      <section class="overview-section">
        <div class="section-inner content-width">
          <h2>Research Summary</h2>
          <p>
            This study developed a powder-metallurgy route for producing nanostructured ZK50 magnesium alloy from elemental Mg, Zn, and Zr powders. High-energy mechanical alloying was used to refine and alloy the powder, followed by hot pipe rolling to consolidate it into thin sheets. The work examined whether this processing sequence could retain a refined structure and provide mechanical properties relevant to future biodegradable-material development.
          </p>
        </div>
      </section>

      <section class="methodology-section">
        <div class="section-inner">
          <h2>Methodology</h2>
          <div class="process-list">
            {methods.map((step) => (
              <article class="process-item">
                <span>{step.number}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="findings-section">
        <div class="section-inner">
          <h2>Key Findings</h2>
          <div class="content-width findings-copy">
            <p>
              Milling progressively refined the powder and broadened the Mg diffraction peaks. The characteristic elemental peaks were nearly eliminated between 38 and 43 h, and complete alloying was reported after 45 h. At that stage, the average particle size was approximately 600 nm and the crystallite size was 8.83 nm.
            </p>
            <p>
              Hot pipe rolling produced consolidated sheets approximately 800 and 720 μm thick under the two processing conditions. The longer annealing treatment produced greater crystallite coarsening and lower mechanical response: hardness decreased from 3.0 to 2.1 GPa and Young's modulus decreased from 68 to 53.2 GPa.
            </p>
          </div>

          <div class="metrics-grid">
            {findings.map((item) => (
              <article class="metric-card">
                <span>{item.value}</span>
                <h3>{item.label}</h3>
                <p>{item.description}</p>
              </article>
            ))}
          </div>

          <div class="figure-grid">
            <figure>
              <img src={`${import.meta.env.BASE_URL}/images/research/mg-auc/fig1.png`} alt="SEM micrographs of ZK50 powder after different mechanical-alloying times" loading="lazy" />
              <figcaption>SEM micrographs showing powder morphology after 3, 5, 10, 19, 31, 40, and 45 h of mechanical alloying.</figcaption>
            </figure>
            <figure>
              <img src={`${import.meta.env.BASE_URL}/images/research/mg-auc/fig3.png`} alt="X-ray diffraction patterns of elemental and mechanically alloyed Mg-Zn-Zr powders" loading="lazy" />
              <figcaption>XRD patterns showing the disappearance of elemental peaks and the development of the alloyed structure with milling time.</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="significance-section">
        <div class="section-inner content-width">
          <h2>Research Significance</h2>
          <p>
            The study demonstrated that mechanical alloying followed by hot pipe rolling can produce nanostructured Mg-Zn-Zr powder and consolidated thin sheets. It established processing feasibility and clarified the effect of annealing on structural coarsening and mechanical response. Corrosion, degradation, and biological performance were outside the scope of this work and remain necessary before biomedical use can be assessed.
          </p>
        </div>
      </section>

      <section class="publication-section">
        <div class="section-inner">
          <h2>Related Publication</h2>
          <div class="publication-card">
            <p class="publication-label">BOOK CHAPTER · 2017</p>
            <h3>{title}</h3>
            <p>{authors}</p>
            <p class="publication-name">{publication}</p>
            <a href={doi} target="_blank" rel="noopener noreferrer">Read publication ↗</a>
          </div>
        </div>
      </section>
    </main>
    <footer><p>© {new Date().getFullYear()} Peter Morcos. All rights reserved.</p></footer>
  </body>
</html>

<style>
  :root { --ink:#172d35; --muted:#687a7e; --accent:#168b83; --line:#e3e9e8; --soft:#f5f8f7; }
  * { box-sizing:border-box; }
  body { margin:0; color:var(--ink); background:white; font-family:Arial,Helvetica,sans-serif; line-height:1.7; }
  .section-inner { width:80%; max-width:1250px; margin:0 auto; }
  .content-width { max-width:1000px; }
  h1,h2,h3 { color:var(--ink); line-height:1.3; }
  h2 { margin:0 0 28px; font-size:30px; }
  p { color:#455b61; }
  .project-intro { padding:55px 0 65px; }
  .back-link { display:inline-block; margin-bottom:28px; color:var(--accent); font-weight:700; text-decoration:none; }
  .back-link:hover { text-decoration:underline; }
  .project-intro h1 { max-width:1050px; margin:0 0 22px; font-size:42px; }
  .project-authors { margin:0 0 4px; font-size:16px; }
  .project-publication { margin:0; color:var(--muted); font-size:15px; }
  .project-meta { display:flex; flex-wrap:wrap; align-items:center; gap:22px; margin-top:24px; }
  .project-status { padding:5px 13px; color:var(--accent); background:#eaf5f3; border-radius:4px; font-size:13px; font-weight:700; }
  .project-meta a,.publication-card a { color:var(--accent); font-size:14px; font-weight:700; text-decoration:none; }
  .overview-section,.findings-section,.publication-section { padding:65px 0 75px; }
  .methodology-section,.significance-section { padding:65px 0 75px; background:var(--soft); }
  .overview-section p,.findings-copy p,.significance-section p { margin:0 0 18px; font-size:17px; line-height:1.9; text-align:justify; }
  .process-list { max-width:1000px; }
  .process-item { display:grid; grid-template-columns:50px 1fr; gap:20px; padding:19px 0; border-bottom:1px solid var(--line); }
  .process-item:last-child { border-bottom:0; }
  .process-item > span { color:var(--accent); font-size:18px; font-weight:700; }
  .process-item h3 { margin:0 0 6px; font-size:19px; }
  .process-item p { margin:0; font-size:15px; line-height:1.8; text-align:justify; }
  .metrics-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin:32px 0 40px; }
  .metric-card { padding:22px 18px; background:var(--soft); border:1px solid var(--line); border-radius:7px; }
  .metric-card > span { color:var(--accent); font-size:24px; font-weight:700; }
  .metric-card h3 { margin:9px 0 5px; font-size:15px; }
  .metric-card p { margin:0; color:var(--muted); font-size:13px; line-height:1.6; }
  .figure-grid { display:grid; grid-template-columns:1fr 1fr; gap:26px; align-items:start; }
  figure { min-width:0; margin:0; }
  figure img { display:block; width:100%; height:auto; background:white; border:1px solid var(--line); border-radius:6px; }
  figcaption { margin-top:11px; color:var(--muted); font-size:15px; line-height:1.6; text-align:center; }
  .publication-card { max-width:900px; padding:28px 32px; background:var(--soft); border:1px solid var(--line); border-radius:8px; }
  .publication-label { margin:0 0 10px; color:var(--accent); font-size:12px; font-weight:700; letter-spacing:1px; }
  .publication-card h3 { margin:0 0 12px; font-size:19px; }
  .publication-card p { margin:5px 0; font-size:14px; }
  .publication-card .publication-name { margin-bottom:18px; color:var(--muted); }
  footer { padding:22px 10%; text-align:center; border-top:1px solid var(--line); }
  footer p { margin:0; color:var(--muted); font-size:13px; }
  @media (max-width:1000px) { .section-inner { width:90%; } .metrics-grid { grid-template-columns:repeat(2,1fr); } }
  @media (max-width:700px) {
    .project-intro,.overview-section,.methodology-section,.findings-section,.significance-section,.publication-section { padding-top:48px; padding-bottom:55px; }
    .project-intro h1 { font-size:32px; }
    h2 { font-size:27px; }
    .overview-section p,.findings-copy p,.significance-section p,.process-item p { text-align:left; }
    .figure-grid { grid-template-columns:1fr; }
  }
</style>
