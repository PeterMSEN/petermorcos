---
import SiteHeader from "../components/SiteHeader.astro";

const cvPath = `${import.meta.env.BASE_URL}/files/Peter-Morcos-CV.pdf`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Curriculum vitae of Peter Morcos." />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <title>CV | Peter Morcos</title>
  </head>
  <body>
    <SiteHeader />
    <main>
      <div class="section-inner">
        <h1>Curriculum Vitae</h1>

        <div id="cv-missing" class="cv-message">
          <p>The CV PDF has not been added yet.</p>
          <p>Place it at <code>public/files/Peter-Morcos-CV.pdf</code>.</p>
        </div>

        <div id="cv-content" hidden>
          <div class="cv-actions">
            <a class="primary-button" href={cvPath} target="_blank" rel="noopener noreferrer">Open PDF ↗</a>
            <a class="secondary-button" href={cvPath} download>Download CV ↓</a>
          </div>

          <object class="cv-viewer" data={cvPath} type="application/pdf">
            <p>
              Your browser cannot display the PDF inline.
              <a href={cvPath} target="_blank" rel="noopener noreferrer">Open the CV PDF</a>.
            </p>
          </object>
        </div>
      </div>
    </main>
    <footer>
      <p>© {new Date().getFullYear()} Peter Morcos. All rights reserved.</p>
    </footer>

    <script define:vars={{ cvPath }}>
      const content = document.querySelector("#cv-content");
      const missing = document.querySelector("#cv-missing");

      fetch(cvPath, { method: "HEAD" })
        .then((response) => {
          if (response.ok) {
            content?.removeAttribute("hidden");
            missing?.setAttribute("hidden", "");
          }
        })
        .catch(() => {});
    </script>
  </body>
</html>

<style>
  :root { --ink: #172d35; --muted: #687a7e; --accent: #168b83; --line: #e3e9e8; --soft: #f5f8f7; }
  * { box-sizing: border-box; }
  body { margin: 0; color: var(--ink); background: white; font-family: Arial, Helvetica, sans-serif; }
  main { min-height: calc(100vh - 137px); padding: 65px 0 90px; }
  .section-inner { width: 80%; max-width: 1250px; margin: 0 auto; }
  h1 { margin: 0 0 30px; color: var(--accent); font-size: 42px; line-height: 1.3; }
  .cv-message { max-width: 760px; padding: 25px 28px; color: var(--muted); background: var(--soft); border: 1px solid var(--line); border-radius: 7px; }
  .cv-message p { margin: 0 0 8px; line-height: 1.7; }
  .cv-message p:last-child { margin-bottom: 0; }
  code { color: var(--ink); font-size: 14px; overflow-wrap: anywhere; }
  .cv-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 25px; }
  .cv-actions a { display: inline-block; padding: 12px 20px; text-decoration: none; font-size: 15px; font-weight: 700; }
  .primary-button { color: white; background: var(--ink); }
  .secondary-button { color: var(--ink); border: 1px solid var(--line); }
  .cv-actions a:hover { color: white; background: var(--accent); border-color: var(--accent); }
  .cv-actions a:focus-visible { outline: 3px solid rgba(22, 139, 131, 0.35); outline-offset: 4px; }
  .cv-viewer { display: block; width: 100%; height: 82vh; min-height: 700px; border: 1px solid var(--line); background: var(--soft); }
  footer { padding: 22px 10%; text-align: center; border-top: 1px solid var(--line); }
  footer p { margin: 0; color: var(--muted); font-size: 13px; }
  @media (max-width: 700px) {
    main { padding-top: 48px; }
    .section-inner { width: 90%; }
    h1 { font-size: 34px; }
    .cv-viewer { height: 70vh; min-height: 520px; }
  }
</style>
