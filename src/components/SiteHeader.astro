---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const navigation = [
  { label: "Home", href: `${base}/`, active: path === base },
  { label: "About", href: `${base}/about/`, active: path === `${base}/about` },
  {
    label: "Research",
    href: `${base}/research/`,
    active: path === `${base}/research` || path.startsWith(`${base}/research/`),
  },
  { label: "Teaching", href: `${base}/teaching/`, active: path === `${base}/teaching` },
  { label: "CV", href: `${base}/cv/`, active: path === `${base}/cv` },
];
---

<header class="site-header">
  <a class="brand" href={`${base}/`}>PM<span>.</span></a>
  <nav aria-label="Main navigation">
    {navigation.map((item) => (
      <a href={item.href} aria-current={item.active ? "page" : undefined}>{item.label}</a>
    ))}
  </nav>
</header>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap");

  .site-header {
    min-height: 78px;
    padding: 0 9%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #e3e9e8;
    background: white;
  }

  .site-header .brand {
    color: #172d35;
    font: 800 26px "Manrope", sans-serif;
    letter-spacing: -2px;
    text-decoration: none;
  }

  .site-header .brand span { color: #168b83; }
  .site-header nav { display: flex; align-items: center; gap: 27px; min-width: 0; }

  .site-header nav a {
    color: #000;
    font: 22px "DM Sans", sans-serif;
    text-decoration: none;
  }

  .site-header nav a:hover { color: #168b83; }
  .site-header nav a[aria-current="page"] { color: #168b83; }

  .site-header a:focus-visible {
    outline: 3px solid rgba(22, 139, 131, 0.35);
    outline-offset: 5px;
    border-radius: 2px;
  }

  @media (max-width: 800px) {
    .site-header { padding: 16px 5%; align-items: flex-start; flex-direction: column; gap: 12px; }
    .site-header nav { width: 100%; flex-wrap: wrap; justify-content: flex-start; gap: 10px 16px; }
    .site-header nav a { font-size: 17px; }
  }

  @media (max-width: 430px) {
    .site-header nav a { font-size: 16px; }
  }
</style>
